<Window x:Class="DroneControl.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:conv="clr-namespace:DroneControl.Wpf.Converters"
        Title="Drone Control"
        Width="1320" Height="860"
        MinWidth="1150" MinHeight="760"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource MaterialDesign.Brush.Background}"
        TextElement.Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
        TextElement.FontSize="14"
        FontFamily="{DynamicResource MaterialDesignFont}"
        Closing="OnClosing">

    <Window.Resources>
        <conv:InverseBooleanConverter x:Key="InverseBool" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <Style x:Key="PresetButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
            <Setter Property="Height" Value="84" />
            <Setter Property="Margin" Value="6" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="20" />
        </Style>

        <Style x:Key="PresetPrimaryButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
            <Setter Property="Height" Value="84" />
            <Setter Property="Margin" Value="6" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="20" />
        </Style>

        <Style x:Key="StopButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
            <Setter Property="Background" Value="{StaticResource StopBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource StopBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Height" Value="76" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="38" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource StopHoverBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CardHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="Opacity" Value="0.7" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding StopCommand}" />
    </Window.InputBindings>

    <DockPanel>
        <!-- Шапка -->
        <materialDesign:ColorZone DockPanel.Dock="Top"
                                  Mode="PrimaryMid"
                                  Padding="20,12"
                                  materialDesign:ElevationAssist.Elevation="Dp4">
            <DockPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="Quadcopter" Width="32" Height="32" VerticalAlignment="Center" />
                    <TextBlock Text="Drone Control" FontSize="22" FontWeight="SemiBold" Margin="12,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="{Binding StatusText}"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           FontSize="14" />
            </DockPanel>
        </materialDesign:ColorZone>

        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="380" />
            </Grid.ColumnDefinitions>

            <!-- Подключение -->
            <materialDesign:Card Grid.Row="0" Grid.ColumnSpan="3"
                                 Padding="16,12" Margin="0,0,0,16"
                                 UniformCornerRadius="16">
                <StackPanel Orientation="Horizontal">
                    <TextBox Width="170"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             materialDesign:HintAssist.Hint="IP дрона"
                             Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding CanEditConnection}" />
                    <TextBox Width="100" Margin="12,0,0,0"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             materialDesign:HintAssist.Hint="UDP порт"
                             Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding CanEditConnection}" />
                    <CheckBox Margin="20,0,0,0" VerticalAlignment="Center"
                              Content="Dry-run (без отправки)"
                              IsChecked="{Binding IsDryRun}"
                              IsEnabled="{Binding CanEditConnection}"
                              ToolTip="Пакеты формируются и показываются, но в сеть не уходят" />
                    <Button Margin="20,0,0,0" MinWidth="150" Height="44"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            materialDesign:ButtonAssist.CornerRadius="22"
                            Command="{Binding ToggleConnectionCommand}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Lan" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding ConnectButtonText}" Margin="8,0,0,0" />
                        </StackPanel>
                    </Button>
                    <Separator Margin="20,4" Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" />
                    <ToggleButton VerticalAlignment="Center"
                                  Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                  IsChecked="{Binding IsControlEnabled}"
                                  IsEnabled="{Binding IsConnected}"
                                  ToolTip="Слать пакеты управления каждые 50 мс" />
                    <TextBlock Text="Передача управления" Margin="10,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </materialDesign:Card>

            <!-- Газ -->
            <materialDesign:Card Grid.Row="1" Grid.Column="0"
                                 Padding="16" Margin="0,0,16,0"
                                 UniformCornerRadius="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Speedometer" Width="22" Height="22" Margin="0,0,8,12" />
                        <TextBlock Text="Газ" Style="{StaticResource CardHeader}" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,0,0,8">
                        <TextBlock HorizontalAlignment="Center" FontSize="34" FontWeight="Bold"
                                   Text="{Binding ThrottlePercent, StringFormat='{}{0:0}%'}" />
                        <TextBlock HorizontalAlignment="Center" Style="{StaticResource Caption}"
                                   Text="{Binding Throttle, StringFormat='байт {0:0} из 255'}" />
                    </StackPanel>

                    <Slider Grid.Row="2"
                            Orientation="Vertical"
                            HorizontalAlignment="Center"
                            Minimum="0" Maximum="255"
                            SmallChange="1" LargeChange="16"
                            TickFrequency="1" IsSnapToTickEnabled="True"
                            Value="{Binding Throttle}"
                            ToolTip="Подача газа: 0 — моторы на минимуме, 128 — удержание высоты" />

                    <UniformGrid Grid.Row="3" Columns="2" Margin="0,12,0,0">
                        <Button Margin="0,0,4,0"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                materialDesign:ButtonAssist.CornerRadius="18"
                                Command="{Binding ThrottleZeroCommand}"
                                Content="0" />
                        <Button Margin="4,0,0,0"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                materialDesign:ButtonAssist.CornerRadius="18"
                                Command="{Binding ThrottleHoldCommand}"
                                Content="128"
                                ToolTip="Центр: удержание высоты" />
                    </UniformGrid>

                    <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,14,0,0">
                        <ToggleButton Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                      IsChecked="{Binding IsAltitudeHold}" />
                        <TextBlock Text="Удержание высоты" Margin="10,0,0,0" VerticalAlignment="Center"
                                   ToolTip="Газ ставится в 128 при взлёте, зависании и STOP" />
                    </StackPanel>
                </Grid>
            </materialDesign:Card>

            <!-- Команды -->
            <materialDesign:Card Grid.Row="1" Grid.Column="1"
                                 Padding="16" Margin="0,0,16,0"
                                 UniformCornerRadius="16">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="GamepadVariant" Width="22" Height="22" Margin="0,0,8,12" />
                            <TextBlock Text="Команды" Style="{StaticResource CardHeader}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Visibility="{Binding IsPresetRunning, Converter={StaticResource BoolToVisibility}}">
                            <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                                         IsIndeterminate="True" Width="18" Height="18" />
                            <TextBlock Text="{Binding ActivePreset}" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </DockPanel>

                    <!-- Параметры движения -->
                    <Grid DockPanel.Dock="Bottom" Margin="6,12,6,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource Caption}"
                                       Text="{Binding Power, StringFormat='Мощность движения: {0:0}%'}" />
                            <Slider Minimum="10" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True"
                                    Value="{Binding Power}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource Caption}"
                                       Text="{Binding DurationSeconds, StringFormat='Длительность движения: {0:0.0} с'}" />
                            <Slider Minimum="0.2" Maximum="5" TickFrequency="0.1" IsSnapToTickEnabled="True"
                                    Value="{Binding DurationSeconds}" />
                        </StackPanel>
                    </Grid>

                    <UniformGrid Columns="4" Rows="3" IsEnabled="{Binding IsControlEnabled}">
                        <!-- Ряд 1 -->
                        <Button Style="{StaticResource PresetPrimaryButton}" Command="{Binding TakeOffCommand}"
                                ToolTip="Флаг 0x01 на 1 с">
                            <StackPanel>
                                <materialDesign:PackIcon Kind="AirplaneTakeoff" Width="30" Height="30" HorizontalAlignment="Center" />
                                <TextBlock Text="Взлёт" HorizontalAlignment="Center" Margin="0,4,0,0" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource PresetPrimaryButton}" Command="{Binding LandCommand}"
                                ToolTip="Флаг 0x02 на 1 с">
                            <StackPanel>
                                <materialDesign:PackIcon Kind="AirplaneLanding" Width="30" Height="30" HorizontalAlignment="Center" />
                                <TextBlock Text="Посадка" HorizontalAlignment="Center" Margin="0,4,0,0" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource PresetButton}" Command="{Binding HoverCommand}"
                                ToolTip="Крен, тангаж, рыскание = 128">
                            <StackPanel>
                                <materialDesign:PackIcon Kind="PauseCircleOutline" Width="30" Height="30" HorizontalAlignment="Center" />
                                <TextBlock Text="Зависание" HorizontalAlignment="Center" Margin="0,4,0,0" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource PresetButton}" Command="{Binding DemoCommand}"
                                ToolTip="Взлёт → вперёд → поворот → назад → посадка">
                            <StackPanel>
                                <materialDesign:PackIcon Kind="PlayCircleOutline" Width="30" Height="30" HorizontalAlignment="Center" />
                                <TextBlock Text="Демо-сценарий" HorizontalAlignment="Center" Margin="0,4,0,0" />
                            </StackPanel>
                        </Button>

                        <!-- Ряд 2 -->
                        <Button Style="{StaticResource PresetButton}" Command="{Binding YawLeftCommand}"
                                ToolTip="Рыскание влево">
                            <StackPanel>
                                <materialDesign:PackIcon Kind="RotateLeft" Width="30" Height="30" HorizontalAlignment="Center" />
                                <TextBlock Text="Поворот влево" HorizontalAlignment="Center" Margin="0,4,0,0" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource PresetButton}" Command="{Binding ForwardCommand}"
                                ToolTip="Тангаж вперёд">
                            <StackPanel>
                                <materialDesign:PackIcon Kind="ArrowUpBold" Width="30" Height="30" HorizontalAlignment="Center" />
                                <TextBlock Text="Вперёд" HorizontalAlignment="Center" Margin="0,4,0,0" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource PresetButton}" Command="{Binding YawRightCommand}"
                                ToolTip="Рыскание вправо">
                            <StackPanel>
                                <materialDesign:PackIcon Kind="RotateRight" Width="30" Height="30" HorizontalAlignment="Center" />
                                <TextBlock Text="Поворот вправо" HorizontalAlignment="Center" Margin="0,4,0,0" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource PresetButton}" Command="{Binding FlipCommand}"
                                ToolTip="Флаг 0x08 на 600 мс, стик вперёд">
                            <StackPanel>
                                <materialDesign:PackIcon Kind="Autorenew" Width="30" Height="30" HorizontalAlignment="Center" />
                                <TextBlock Text="Флип" HorizontalAlignment="Center" Margin="0,4,0,0" />
                            </StackPanel>
                        </Button>

                        <!-- Ряд 3 -->
                        <Button Style="{StaticResource PresetButton}" Command="{Binding LeftCommand}"
                                ToolTip="Крен влево">
                            <StackPanel>
                                <materialDesign:PackIcon Kind="ArrowLeftBold" Width="30" Height="30" HorizontalAlignment="Center" />
                                <TextBlock Text="Влево" HorizontalAlignment="Center" Margin="0,4,0,0" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource PresetButton}" Command="{Binding BackCommand}"
                                ToolTip="Тангаж назад">
                            <StackPanel>
                                <materialDesign:PackIcon Kind="ArrowDownBold" Width="30" Height="30" HorizontalAlignment="Center" />
                                <TextBlock Text="Назад" HorizontalAlignment="Center" Margin="0,4,0,0" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource PresetButton}" Command="{Binding RightCommand}"
                                ToolTip="Крен вправо">
                            <StackPanel>
                                <materialDesign:PackIcon Kind="ArrowRightBold" Width="30" Height="30" HorizontalAlignment="Center" />
                                <TextBlock Text="Вправо" HorizontalAlignment="Center" Margin="0,4,0,0" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource PresetButton}" Command="{Binding CalibrateGyroCommand}"
                                ToolTip="Флаг 0x80 на 2 с. Только на земле!">
                            <StackPanel>
                                <materialDesign:PackIcon Kind="CompassOutline" Width="30" Height="30" HorizontalAlignment="Center" />
                                <TextBlock Text="Калибровка" HorizontalAlignment="Center" Margin="0,4,0,0" />
                            </StackPanel>
                        </Button>
                    </UniformGrid>
                </DockPanel>
            </materialDesign:Card>

            <!-- Состояние и журнал -->
            <materialDesign:Card Grid.Row="1" Grid.Column="2"
                                 Padding="16"
                                 UniformCornerRadius="16">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ChartBar" Width="22" Height="22" Margin="0,0,8,12" />
                            <TextBlock Text="Отправляемые каналы" Style="{StaticResource CardHeader}" />
                        </StackPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="40" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="28" />
                                <RowDefinition Height="28" />
                                <RowDefinition Height="28" />
                                <RowDefinition Height="28" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Крен" VerticalAlignment="Center" />
                            <ProgressBar Grid.Row="0" Grid.Column="1" Maximum="255" Height="8" Value="{Binding RollValue, Mode=OneWay}" />
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding RollValue}" HorizontalAlignment="Right" VerticalAlignment="Center" />

                            <TextBlock Grid.Row="1" Text="Тангаж" VerticalAlignment="Center" />
                            <ProgressBar Grid.Row="1" Grid.Column="1" Maximum="255" Height="8" Value="{Binding PitchValue, Mode=OneWay}" />
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding PitchValue}" HorizontalAlignment="Right" VerticalAlignment="Center" />

                            <TextBlock Grid.Row="2" Text="Газ" VerticalAlignment="Center" />
                            <ProgressBar Grid.Row="2" Grid.Column="1" Maximum="255" Height="8" Value="{Binding ThrottleValue, Mode=OneWay}" />
                            <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding ThrottleValue}" HorizontalAlignment="Right" VerticalAlignment="Center" />

                            <TextBlock Grid.Row="3" Text="Рыскание" VerticalAlignment="Center" />
                            <ProgressBar Grid.Row="3" Grid.Column="1" Maximum="255" Height="8" Value="{Binding YawValue, Mode=OneWay}" />
                            <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding YawValue}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>

                        <TextBlock Margin="0,10,0,0" Style="{StaticResource Caption}" Text="Флаги" />
                        <TextBlock Text="{Binding FlagsText}" FontFamily="Consolas" />

                        <TextBlock Margin="0,8,0,0" Style="{StaticResource Caption}" Text="Последний пакет" />
                        <TextBlock Text="{Binding LastPacketHex}" FontFamily="Consolas" FontSize="15" />

                        <Expander Margin="-16,8,-16,0" Header="Экспериментальные флаги">
                            <StackPanel Margin="16,0,16,8">
                                <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,6"
                                           Text="Назначение битов не подтверждено, проверяйте на земле со снятыми пропеллерами." />
                                <CheckBox Content="0x10 · Headless" IsChecked="{Binding IsHeadless}" />
                                <CheckBox Content="0x20 · Возврат / разблокировка" IsChecked="{Binding IsReturnOrUnlock}" />
                                <CheckBox Content="0x40 · Подсветка" IsChecked="{Binding IsLight}" />
                            </StackPanel>
                        </Expander>

                        <DockPanel Margin="0,8,0,4">
                            <Button DockPanel.Dock="Right"
                                    Style="{StaticResource MaterialDesignFlatButton}"
                                    Command="{Binding ClearLogCommand}"
                                    Content="Очистить" Padding="8,0" Height="28" />
                            <TextBlock Text="Журнал" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </DockPanel>
                    </StackPanel>

                    <ListBox ItemsSource="{Binding LogLines}"
                             FontFamily="Consolas" FontSize="12"
                             VirtualizingPanel.IsVirtualizing="True"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="Padding" Value="4,2" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </materialDesign:Card>

            <!-- STOP -->
            <Grid Grid.Row="2" Grid.ColumnSpan="3" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="280" />
                </Grid.ColumnDefinitions>

                <Button Style="{StaticResource StopButton}"
                        Command="{Binding StopCommand}"
                        ToolTip="Прервать текущую команду и зависнуть (Esc)">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="StopCircle" Width="36" Height="36" VerticalAlignment="Center" />
                        <TextBlock Text="STOP · прервать команды" Margin="12,0,0,0" VerticalAlignment="Center" />
                        <TextBlock Text="Esc" Margin="12,0,0,0" Opacity="0.7" FontSize="14" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Grid.Column="2" Height="76"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        BorderBrush="{StaticResource StopBrush}"
                        Foreground="{StaticResource StopBrush}"
                        BorderThickness="2"
                        materialDesign:ButtonAssist.CornerRadius="38"
                        Command="{Binding EmergencyStopCommand}"
                        ToolTip="Флаг 0x04: моторы останавливаются сразу, дрон упадёт">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="AlertOctagon" Width="26" Height="26" VerticalAlignment="Center" />
                        <TextBlock Text="Стоп моторов" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="16" />
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
